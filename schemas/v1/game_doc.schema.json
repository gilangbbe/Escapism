{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://escapism.local/schemas/v1/game_doc.schema.json",
  "title": "Game corpus document",
  "description": "One entry from game.jsonl. Every line of the corpus must validate against this schema.",
  "type": "object",
  "required": ["id", "kind", "scope"],
  "properties": {
    "id": {"type": "string", "minLength": 1},
    "kind": {
      "type": "string",
      "enum": [
        "meta", "lore", "rule", "objective",
        "location", "item", "npc",
        "hint", "puzzle", "recipe", "discovery"
      ]
    },
    "scope": {
      "type": "array",
      "items": {"type": "string", "pattern": "^(all|act[0-9]+)$"},
      "minItems": 1
    },
    "title": {"type": "string"},
    "text": {"type": "string"},
    "location": {"type": "string"},
    "tier": {"type": "integer", "minimum": 1, "maximum": 3},
    "objective": {"type": "string"},
    "trigger": {
      "type": "object",
      "properties": {
        "verb": {"type": "string"},
        "target": {"type": "string"},
        "on": {"type": "string"},
        "ingredients": {"type": "array", "items": {"type": "string"}}
      },
      "additionalProperties": true
    },
    "preconditions": {
      "type": "object",
      "properties": {
        "inventory_has": {"type": "array", "items": {"type": "string"}},
        "object_state": {"type": "object", "additionalProperties": {"type": "string"}},
        "npc_state": {"type": "object", "additionalProperties": {"type": "string"}},
        "discovered": {"type": "array", "items": {"type": "string"}}
      },
      "additionalProperties": false
    },
    "effects": {
      "type": "object",
      "properties": {
        "inventory_add": {"type": "array", "items": {"type": "string"}},
        "inventory_remove": {"type": "array", "items": {"type": "string"}},
        "discovered_items": {"type": "array", "items": {"type": "string"}},
        "object_state": {"type": "object", "additionalProperties": {"type": "string"}},
        "npc_state": {"type": "object", "additionalProperties": {"type": "string"}},
        "objectives": {
          "type": "object",
          "additionalProperties": {
            "type": "string",
            "enum": ["active", "locked", "complete", "failed"]
          }
        },
        "current_location": {"type": "string"},
        "scene_id": {"type": "string"}
      },
      "additionalProperties": false
    }
  },
  "allOf": [
    {
      "if": {"properties": {"kind": {"const": "hint"}}, "required": ["kind"]},
      "then": {"required": ["tier", "text"]}
    },
    {
      "if": {"properties": {"kind": {"const": "puzzle"}}, "required": ["kind"]},
      "then": {"required": ["trigger"]}
    },
    {
      "if": {"properties": {"kind": {"const": "recipe"}}, "required": ["kind"]},
      "then": {"required": ["trigger", "preconditions", "effects"]}
    },
    {
      "if": {"properties": {"kind": {"const": "discovery"}}, "required": ["kind"]},
      "then": {"required": ["trigger", "effects"]}
    }
  ],
  "additionalProperties": true
}
